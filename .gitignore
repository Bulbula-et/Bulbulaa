# Private deployment configuration (never commit credentials)
/config/env.local.json
/config/env.local.json.tmp.*

# Composer dependencies and local test-analysis caches
/vendor/
/.phpunit.cache/
/.phpstan.cache/

# Uploaded/processed branch media (deployment data, not source control)
/public_html/media/branches/
!/public_html/media/.htaccess

# Runtime ephemeral files (auto-created by Bulbula.et V1)
storage/cache/*.cache
storage/cache/*.cache.json
storage/cache/_*.json
storage/logs/*.log
storage/sessions/*
storage/rate_limits/*
!storage/cache/.gitkeep
!storage/logs/.gitkeep
!storage/sessions/.gitkeep
!storage/rate_limits/.gitkeep
