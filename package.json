{
  "devDependencies": {
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "esbuild": "0.28.2",
    "font-awesome": "4.7.0",
    "grapesjs": "0.23.8",
    "grapesjs-preset-newsletter": "1.0.2"
  },
  "name": "bulbula-password-strength-assets",
  "private": true,
  "description": "Build-only, self-hosted Bulbula password-strength indicator",
  "scripts": {
    "build:password-strength": "esbuild assets-src/password-strength-entry.js --bundle --minify --target=es2020 --format=iife --outfile=public_html/assets/js/vendor/password-strength.js",
    "build:email-editor": "esbuild assets-src/email-editor-entry.js --bundle --minify --legal-comments=none --target=es2020 --format=iife --outfile=public_html/assets/js/vendor/email-editor.js"
  }
}
